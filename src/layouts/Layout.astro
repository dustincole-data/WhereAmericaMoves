---
// The document shell. Every string in the head is a CopyRecord — 02 counted 90 <meta>
// tags across the site, and `<meta content>` has nowhere to hang a data-cite attribute,
// which is the whole reason the module is a build-time ledger rather than DOM markup.
import '../styles/tokens.css';
import '../styles/app.css';
import type { CopyRecord } from '../copy/record';
import { SITE_NAME } from '../copy';

interface Props {
  title: CopyRecord;
  description: CopyRecord;
  ogTitle: CopyRecord;
  ogDesc: CopyRecord;
  ogImage: string; // absolute URL
  canonical: string; // absolute URL
}
const { title, description, ogTitle, ogDesc, ogImage, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title.text}</title>
    <meta name="description" content={description.text} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f5f7" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME.text} />
    <meta property="og:title" content={ogTitle.text} />
    <meta property="og:description" content={ogDesc.text} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle.text} />
    <meta name="twitter:description" content={ogDesc.text} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <main>
      <slot />
    </main>

    <div class="dcd-footer">
      <a
        class="dcd-mark"
        href="https://dustincoledata.com"
        target="_blank"
        rel="noopener"
        aria-label="A Dustin Cole Data project"
      >
        <svg class="dcd-mark-logo" viewBox="3.8 17.1 56.5 29.8" aria-hidden="true" focusable="false">
          <g transform="translate(2.943 46.426) scale(0.040753 -0.040753)">
            <path fill="currentColor" d="M22 269Q22 388 88.5 468.0Q155 548 262 548Q345 548 408 488V718H579V0H422V61Q354 -10 262 -10Q155 -10 88.5 70.5Q22 151 22 269ZM200 269Q200 209 230.5 176.5Q261 144 303 144Q346 144 376.0 177.0Q406 210 406 270Q406 331 376.0 362.5Q346 394 303.0 394.0Q260 394 230.0 362.0Q200 330 200 269Z"></path>
            <path fill="currentColor" transform="translate(605 0)" d="M293 -10Q173 -10 97.5 68.0Q22 146 22 269Q22 389 99.5 468.5Q177 548 293 548Q404 548 479.5 479.0Q555 410 566 298H384Q382 342 357.5 368.0Q333 394 294 394Q249 394 224.0 361.0Q199 328 199 269Q199 208 223.5 175.5Q248 143 294 143Q334 143 357.5 168.5Q381 194 384 240H566Q555 125 481.5 57.5Q408 -10 293 -10Z"></path>
            <path class="dcd-mark-dot" transform="translate(1163 0)" d="M241 104Q241 56 211.0 25.5Q181 -5 133.0 -5.0Q85 -5 54.5 25.5Q24 56 24 104Q24 153 54.5 183.5Q85 214 133.0 214.0Q181 214 211.0 183.5Q241 153 241 104Z"></path>
          </g>
        </svg>
        <i class="dcd-mark-rule" aria-hidden="true"></i>
        <span class="dcd-mark-words"
          ><span class="dcd-mark-name">Dustin Cole</span><span class="dcd-mark-suffix">Data</span></span
        >
      </a>
    </div>
    <style>
      .dcd-footer {
        display: flex;
        justify-content: center;
        padding: 0 1rem calc(2.25rem + env(safe-area-inset-bottom, 0px));
      }
      .dcd-mark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px 7px 10px;
        border-radius: 999px;
        border: 1px solid rgba(22, 24, 29, 0.1);
        text-decoration: none;
        line-height: 1;
        opacity: 0.85;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .dcd-mark:hover {
        opacity: 1;
        transform: translateY(-1px);
      }
      .dcd-mark:focus-visible {
        outline: 2px solid #4a3aab;
        outline-offset: 2px;
      }
      .dcd-mark-logo {
        height: 13px;
        width: 24.7px;
        flex: none;
        display: block;
        color: #16181d;
      }
      .dcd-mark-dot {
        fill: #3b5bdb;
      }
      .dcd-mark-rule {
        width: 1px;
        height: 13px;
        flex: none;
        background: rgba(22, 24, 29, 0.14);
      }
      .dcd-mark-words {
        display: inline-flex;
        align-items: baseline;
        gap: 7px;
      }
      .dcd-mark-name {
        font-family: 'Archivo', -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: -0.01em;
        color: #16181d;
      }
      .dcd-mark-suffix {
        font-family: ui-monospace, 'Cascadia Code', 'Segoe UI Mono', Menlo, monospace;
        font-weight: 500;
        font-size: 9px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #565c68;
      }
      @media print {
        .dcd-mark {
          display: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .dcd-mark {
          transition: none;
        }
      }
    </style>
  </body>
</html>
