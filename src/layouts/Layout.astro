---
// Shared document shell — head, meta, OG/Twitter cards (08 §8.3–§8.4).
import '../styles/tokens.css';
import '../styles/app.css';

interface Props {
  title: string;
  description: string;
  ogTitle: string;
  ogDesc: string;
  ogImage: string; // absolute URL
  canonical: string; // absolute URL
}
const { title, description, ogTitle, ogDesc, ogImage, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F5EFE4" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Where America Moves" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body data-palette="#1A6E9E,#BC4E37">
    <main>
      <slot />
    </main>

    <!-- dustincoledata brand mark -->
    <a class="dcd-mark" href="https://dustincoledata.com" target="_blank" rel="noopener">
      <span class="dcd-mark-name">Dustin Cole</span><span class="dcd-mark-suffix">Data</span>
    </a>
    <style>
      .dcd-mark{position:fixed;left:max(14px,env(safe-area-inset-left,0px));
        bottom:max(14px,env(safe-area-inset-bottom,0px));z-index:60;
        display:inline-flex;align-items:baseline;gap:7px;padding:7px 12px;border-radius:999px;
        background:rgba(255,255,255,.72);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
        border:1px solid rgba(22,24,29,.10);box-shadow:0 2px 10px rgba(16,18,24,.06);
        text-decoration:none;line-height:1;opacity:.85;transition:opacity .2s ease,transform .2s ease;}
      .dcd-mark:hover{opacity:1;transform:translateY(-1px);}
      .dcd-mark:focus-visible{outline:2px solid #4A3AAB;outline-offset:2px;}
      .dcd-mark-name{font-family:'Archivo',-apple-system,'Segoe UI','Helvetica Neue',Arial,sans-serif;
        font-weight:600;font-size:13px;letter-spacing:-.01em;color:#16181D;}
      .dcd-mark-suffix{font-family:ui-monospace,'Cascadia Code','Segoe UI Mono',Menlo,monospace;
        font-weight:500;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#565C68;}
      @media print{.dcd-mark{display:none;}}
      @media (prefers-reduced-motion:reduce){.dcd-mark{transition:none;}}
    </style>
  </body>
</html>
