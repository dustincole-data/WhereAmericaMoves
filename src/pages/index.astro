---
// THE SHAPE. What the 2026-08-07 form ruling changed and what it did not.
//
// The arc, the spine and the plumbing are untouched: the crowd is still first and still the
// control, the three beats are still captions, and the package wiring, the copy module, the
// lint and the footer stamp are the same files they were. What changed is the mark.
//
// 2026-08-10 — THE CLAIM REGISTER IS GONE. It was a full-width bar in a section of its own,
// and it was the only mark drawing the headline. What replaced it is a dashed outer ring on
// every cluster, whose annulus area is that metro's own suppressed mass at the cluster's own
// scale — so the absence is now drawn thirty times inside the mark the reader is already
// looking at, instead of once in a chart below it. The two quantities are NOT the same: the
// headline's figure is national and belongs to no metro, so `WITHHELD_LINE` and `FLOOR_NOTE`
// moved up beside the headline and carry it in type. The legend block went with the bar —
// `REGISTER_FRAME` existed to tell two registers apart and there is one left.
//
// Rounds 1–4 drew 863 marks at real geography and put lines on selection. That route was
// rejected four times on one axis — "it's just a bunch of little lines, and the volume
// doesn't really tell them" — and 13 ruled the replacement: thirty CLUSTERS OF DOTS, in the
// rough shape of the country on a wide screen and on a four-column grid on a phone, every
// one of which re-forms to its own exchange with whichever metro the reader chooses.
//
// TYPE AND MARK STILL DO NOT OVERLAP, and the band above the stage is still the reason. A
// headline set inside the mark's own empty regions is honest only until a reader uses it.
//
// 14 kept that mark and moved it onto the country. The clusters now sit at their TRUE
// d3-geoAlbers points on a real lower-48 coastline and stay there through every selection —
// where they overlap they overlap, resolved by translucency and by a leader from each name
// to its own point, never by nudging a metro. One stream per partner carries the exchange,
// and its direction is the sign of it. A per-thousand toggle scales the mark and prints
// nothing: the readout still hands over the two published cells.
//
// EVERY LAYOUT IS COMPUTED HERE, AT BUILD, from the verified package: sixty-one views, the
// one position array and the coastline, in `lib/field.ts`, against the same formulas
// `lib/clusters.ts` hands the browser. The client is given counts and coordinates and
// derives the rest, so there is no second implementation of a radius to drift.
//
// THE OVERLAY CARRIES EVERY WORD. The canvas draws no text at all; the names, the thirty
// controls and their labels are server-rendered SVG, so the dist scan reads real strings and
// a keyboard reaches every metro whether or not the picture drew.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetroReadout from '../components/MetroReadout.astro';
import Key from '../components/Key.astro';
import { METROS } from '../lib/metros';
import { buildField } from '../lib/field';
import { WIDE } from '../lib/clusters';
import { metroCopy, pairCopy } from '../copy';
import {
  METRIC_LABEL,
  METRIC_TOTAL,
  METRIC_RATE,
  PAIR_UNIT,
  HOME_TITLE,
  HOME_DESC,
  SITE_NAME,
  HEADLINE,
  STANDFIRST,
  WITHHELD_LINE,
  FLOOR_NOTE,
  COMPLEMENT,
  BEAT_COUNTY,
  BEAT_RATES,
  BEAT_ABSENT,
  HERO_ARIA,
  SELECT_LABEL,
  AT_REST,
  ON_SELECT,
  RESET,
  SOURCE_TAG,
} from '../copy';

import hues from '../assets/09-hues.json';

const field = buildField();
const byCbsa = new Map(METROS.map((m) => [m.cbsa, metroCopy(m.cbsa)]));
const metros = METROS.map((m) => byCbsa.get(m.cbsa)!);
const placed = field.codes.map((c) => byCbsa.get(c)!);
const pairs = pairCopy();

const site = Astro.site!;
const canonical = new URL('/', site).href;
const ogImage = new URL('/og/index.png', site).href;

// Geometry and apparatus only. No figure of any kind travels to the client: a dot COUNT is
// a quantity already divided by a scale this file derived, and the scale itself is never
// sent, printed or spoken.
const heroData = {
  codes: field.codes,
  views: field.views,
  rates: field.rates,
  wpos: field.wpos,
  ppos: field.ppos,
  outline: field.outline,
  hues: Object.fromEntries(field.codes.map((c) => [c, (hues.metros as Record<string, { hub: string }>)[c]?.hub ?? '#15181d'])),
  focus: null,
};
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESC}
  ogTitle={SITE_NAME}
  ogDesc={HOME_DESC}
  ogImage={ogImage}
  canonical={canonical}
>
  <Header />

  <!-- ── the hero: one thin band, and the mark taking the rest of the screen ── -->
  <section class="hero">
    <div class="band">
      <!-- TWO COLUMNS, EACH A FIGURE AND ITS OWN EVIDENCE, and the wrappers are why: the band
           is a named-area grid, so a bare <p> added to it gets AUTO-PLACED — which put the
           withheld line in an implicit row on a wide screen and above the H1 on a phone, where
           the areas collapse. Grouping puts each line in the column that owns it and fixes the
           reading order at every width.
             head      the headline, then the national figure the headline is about
             universe  the universe it counts, then the crowd's own total, which is the other
                       total on the page and the one the piece exists to keep separate
           The claim register bar that used to carry the first of these is gone; the rings on
           the clusters draw each metro's own share of the same absence, which is a DIFFERENT
           quantity, so this is the only place the national figure appears. -->
      <div class="bhead">
        <h1>{HEADLINE.text}</h1>
        <!-- The dashed ring, at type size, in front of the national figure. The rings on the
             map are each metro's OWN share of this and the two are different quantities — but
             they are the same KIND of absence, and the glyph is what says so without a sentence
             claiming it. Same dash, same weight, same grey as the canvas draws. -->
        <p class="withheld">
          <svg class="ringmark" viewBox="0 0 16 16" aria-hidden="true"
            ><circle cx="8" cy="8" r="6" fill="none" stroke="#5c6068" stroke-width="1.1" stroke-dasharray="3 3" /></svg
          >{WITHHELD_LINE.text} <span class="floor">{FLOOR_NOTE.text}</span>
        </p>
      </div>
      <div class="buniverse">
        <p class="sf">{STANDFIRST[0].text} <span>{STANDFIRST[1].text}</span></p>
        <p class="complement">{COMPLEMENT.text}</p>
      </div>

      <!-- One slot, on its own row, holding the invitation at rest, the key to the selected
           view otherwise, and the chosen metro's own record beneath both — with the band's
           height fixed, so a click never resizes the mark under the pointer. -->
      <div class="panel">
        <p class="atrest" id="atrest">{AT_REST.text}</p>
        <p class="atrest" id="onsel" hidden>{ON_SELECT.text}</p>
        {metros.map((m) => <MetroReadout m={m} />)}
      </div>

      <div class="pick">
        <label class="vh" for="metroPick">{SELECT_LABEL.text}</label>
        <select id="metroPick">
          <option value="">{RESET.text}</option>
          {metros.map((m) => <option value={m.cbsa}>{m.name.text}, {m.state.text}</option>)}
        </select>

        <!-- The metric, and it only exists once a metro is chosen: the resting cluster is one
             metro's own two published columns, and a rate has no pair to be a rate of. -->
        <div class="metric" id="metric" hidden>
          <span class="vh" id="metricLab">{METRIC_LABEL.text}</span>
          <div class="seg" role="group" aria-labelledby="metricLab">
            <button type="button" data-metric="people" aria-pressed="true">{METRIC_TOTAL.text}</button>
            <button type="button" data-metric="rate" aria-pressed="false">{METRIC_RATE.text}</button>
          </div>
        </div>
      </div>
    </div>

    <div class="stage" id="stage">
      <!-- The dots. Aria-hidden because everything it draws is reachable through the thirty
           labelled controls in the overlay and through the readout the selection opens. -->
      <canvas id="dots" aria-hidden="true"></canvas>

      <svg
        id="over"
        class="over"
        viewBox={`0 0 ${WIDE.w} ${WIDE.h}`}
        preserveAspectRatio="xMidYMid meet"
        role="group"
        aria-label={HERO_ARIA.text}
      >
        <!-- A leader per metro, hidden until the placement says it is owed one: the clusters
             sit at true projected points and overlap, so a name at the rim of a merged mass
             names the mass. The line runs to the metro's own point and ends on it. -->
        <g class="leaders" aria-hidden="true">
          {placed.map((m) => (
            <g data-leader={m.cbsa} hidden>
              <line class="lead-halo" x1="0" y1="0" x2="0" y2="0" />
              <line class="lead-line" x1="0" y1="0" x2="0" y2="0" />
              <circle class="lead-halo-dot" cx="0" cy="0" r="2.6" />
              <circle class="lead-pip" cx="0" cy="0" r="1.5" />
            </g>
          ))}
        </g>

        <g class="hits">
          {placed.map((m) => (
            <g data-metro={m.cbsa} role="button" tabindex="0" aria-pressed="false" aria-label={m.aria.text}>
              <circle class="hit" cx="0" cy="0" r="18" fill="transparent" />
            </g>
          ))}
        </g>
        <!-- The names ship placed against a build-time metric and are re-placed against
             measured text the moment the client runs: only the browser can close a fit.
             Astro keeps HTML comments, so a ticket number written here is a figure in dist
             that traces to no ledger entry, and the backstop is right to say so. -->
        <g class="names">
          {placed.map((m, i) => (
            <text
              data-label={m.cbsa}
              text-anchor="middle"
              transform={`translate(${field.wpos[i * 2]},${field.wpos[i * 2 + 1] + 26})`}
            >{m.name.text}</text>
          ))}
        </g>
        <text id="sourcetag" class="srctag" text-anchor="middle" style="display:none">{SOURCE_TAG.text}</text>

        <!-- The on-chart key: which colour means what, named to whichever metro is
             selected. One of thirty, swapped by hero.ts's `select`, same mechanism as
             the readouts below — no client-built copy. The rect is sized to the
             text's own measured box in hero.ts: a halo alone was not enough
             against whatever ends up under the corner. -->
        <g class="keys" aria-hidden="true">
          {placed.map((m) => (
            <g data-metro-key={m.cbsa} hidden>
              <rect class="keybg" />
              <text class="keytext">
                <tspan class="dot loss" x="0" dy="0">●</tspan><tspan> {m.keyLoss.text}</tspan>
                <tspan class="dot gain" x="0" dy="1.5em">●</tspan><tspan> {m.keyGain.text}</tspan>
              </text>
            </g>
          ))}
        </g>
      </svg>

      <!-- The pair readout. Every block is here in dist and merely unhidden on hover, so the
           scan reads the real cells and the client assembles no figure of its own. Only pairs
           with both directions disclosed have one: where a direction is missing the partner is
           a dashed empty ring, and a card reading "no flow" would be the zero this piece
           refuses to write. -->
      <div class="paircard" id="paircard" hidden aria-hidden="true">
        {pairs.map((p) => (
          <div class="pair" data-pair={p.key} hidden>
            {p.rows.map((r) => (
              <div class="prow">
                <span class="plab">{r.label.text}</span>
                <span class:list={['pfig', 'tnum', { more: r.more }]}>{r.fig.text}</span>
              </div>
            ))}
            <div class="punit">{PAIR_UNIT.text}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- The key rides WITH the picture, under it, where a legend belongs — and it is now made
         of the mark's own glyphs rather than a row of sentences. See Key.astro: the strip used
         to be six paragraphs describing five shapes the picture already draws. -->
    <Key />
  </section>

  <div class="wrap">
    <!-- ── the three remaining beats, as captions ── -->
    <div class="beats">
      {[BEAT_COUNTY, BEAT_RATES, BEAT_ABSENT].map((b) => (
        <section class="beat">
          <h2>{b[0].text}</h2>
          {b.slice(1).map((p) => <p>{p.text}</p>)}
        </section>
      ))}
    </div>

    <Footer />
  </div>

  <div class="vh" id="live" aria-live="polite"></div>

  <script type="application/json" id="hero-data" set:html={JSON.stringify(heroData)} is:inline></script>
  <script>
    import '../lib/hero.ts';
  </script>
</Layout>
