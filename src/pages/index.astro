---
// THE SHAPE. What the 2026-08-07 form ruling changed and what it did not.
//
// The arc, the spine and the plumbing are untouched: the crowd is still first and still the
// control, the claim register still sits beneath it on its own scale, the three beats are
// still captions, and the package wiring, the copy module, the lint and the footer stamp
// are the same files they were. What changed is the mark.
//
// Rounds 1–4 drew 863 marks at real geography and put lines on selection. That route was
// rejected four times on one axis — "it's just a bunch of little lines, and the volume
// doesn't really tell them" — and 13 ruled the replacement: thirty CLUSTERS OF DOTS, in the
// rough shape of the country on a wide screen and on a four-column grid on a phone, every
// one of which re-forms to its own exchange with whichever metro the reader chooses.
//
// TYPE AND MARK STILL DO NOT OVERLAP, and the band above the stage is still the reason. A
// headline set inside the mark's own empty regions is honest only until a reader uses it.
//
// EVERY LAYOUT IS COMPUTED HERE, AT BUILD, from the verified package: thirty-one views and
// their relaxed positions, in `lib/field.ts`, against the same formulas `lib/clusters.ts`
// hands the browser. The client is given counts and coordinates and derives the rest, so
// there is no second implementation of a radius to drift.
//
// THE OVERLAY CARRIES EVERY WORD. The canvas draws no text at all; the names, the thirty
// controls and their labels are server-rendered SVG, so the dist scan reads real strings and
// a keyboard reaches every metro whether or not the picture drew.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetroReadout from '../components/MetroReadout.astro';
import { METROS } from '../lib/metros';
import { assertPlate } from '../lib/package';
import { buildField } from '../lib/field';
import { WIDE } from '../lib/clusters';
import { metroCopy } from '../copy';
import {
  HOME_TITLE,
  HOME_DESC,
  SITE_NAME,
  HEADLINE,
  STANDFIRST,
  WITHHELD_LINE,
  FLOOR_NOTE,
  REGISTER_CLAIM,
  BAR_DISCLOSED,
  BAR_WITHHELD,
  BAR_WITHHELD_SUB,
  REGISTER_FRAME,
  COMPLEMENT,
  LEGEND,
  HERO_LINES,
  BEAT_COUNTY,
  BEAT_RATES,
  BEAT_ABSENT,
  HERO_ARIA,
  SELECT_LABEL,
  AT_REST,
  ON_SELECT,
  RESET,
  SOURCE_TAG,
} from '../copy';

import claimSvgRaw from '../assets/09-claim.svg?raw';
import hues from '../assets/09-hues.json';

// The one drift a hash cannot see: a plate drawn from an older package beside a fresh
// manifest. The claim register is the last baked plate on the page and it is still asserted.
const claimSvg = assertPlate(claimSvgRaw, '09-claim.svg');
const cut = Number(/data-cut="([\d.]+)"/.exec(claimSvg)![1]);

const field = buildField();
const byCbsa = new Map(METROS.map((m) => [m.cbsa, metroCopy(m.cbsa)]));
const metros = METROS.map((m) => byCbsa.get(m.cbsa)!);
const placed = field.codes.map((c) => byCbsa.get(c)!);

const site = Astro.site!;
const canonical = new URL('/', site).href;
const ogImage = new URL('/og/index.png', site).href;

// Geometry and apparatus only. No figure of any kind travels to the client: a dot COUNT is
// a quantity already divided by a scale this file derived, and the scale itself is never
// sent, printed or spoken.
const heroData = {
  codes: field.codes,
  views: field.views,
  wpos: field.wpos,
  ppos: field.ppos,
  hues: Object.fromEntries(field.codes.map((c) => [c, (hues.metros as Record<string, { hub: string }>)[c]?.hub ?? '#15181d'])),
  focus: null,
};
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESC}
  ogTitle={SITE_NAME}
  ogDesc={HOME_DESC}
  ogImage={ogImage}
  canonical={canonical}
>
  <Header />

  <!-- ── the hero: one thin band, and the mark taking the rest of the screen ── -->
  <section class="hero">
    <div class="band">
      <h1>{HEADLINE.text}</h1>
      <p class="sf">{STANDFIRST[0].text} <span>{STANDFIRST[1].text}</span></p>

      <!-- One slot, on its own row, holding the invitation at rest, the key to the selected
           view otherwise, and the chosen metro's own record beneath both — with the band's
           height fixed, so a click never resizes the mark under the pointer. -->
      <div class="panel">
        <p class="atrest" id="atrest">{AT_REST.text}</p>
        <p class="atrest" id="onsel" hidden>{ON_SELECT.text}</p>
        {metros.map((m) => <MetroReadout m={m} />)}
      </div>

      <div class="pick">
        <label class="vh" for="metroPick">{SELECT_LABEL.text}</label>
        <select id="metroPick">
          <option value="">{RESET.text}</option>
          {metros.map((m) => <option value={m.cbsa}>{m.name.text}, {m.state.text}</option>)}
        </select>
      </div>
    </div>

    <div class="stage" id="stage">
      <!-- The dots. Aria-hidden because everything it draws is reachable through the thirty
           labelled controls in the overlay and through the readout the selection opens. -->
      <canvas id="dots" aria-hidden="true"></canvas>

      <svg
        id="over"
        class="over"
        viewBox={`0 0 ${WIDE.w} ${WIDE.h}`}
        preserveAspectRatio="xMidYMid meet"
        role="group"
        aria-label={HERO_ARIA.text}
      >
        <g class="hits">
          {placed.map((m) => (
            <g data-metro={m.cbsa} role="button" tabindex="0" aria-pressed="false" aria-label={m.aria.text}>
              <circle class="hit" cx="0" cy="0" r="18" fill="transparent" />
            </g>
          ))}
        </g>
        <!-- The names ship placed against a build-time metric and are re-placed against
             measured text the moment the client runs: only the browser can close a fit.
             Astro keeps HTML comments, so a ticket number written here is a figure in dist
             that traces to no ledger entry, and the backstop is right to say so. -->
        <g class="names">
          {placed.map((m, i) => (
            <text
              data-label={m.cbsa}
              text-anchor="middle"
              transform={`translate(${field.wpos.rest[i * 2]},${field.wpos.rest[i * 2 + 1] + 26})`}
            >{m.name.text}</text>
          ))}
        </g>
        <text id="sourcetag" class="srctag" text-anchor="middle" style="display:none">{SOURCE_TAG.text}</text>

        <!-- The on-chart key: which colour means what, named to whichever metro is
             selected. One of thirty, swapped by hero.ts's `select`, same mechanism as
             the readouts below — no client-built copy. The rect is sized to the
             text's own measured box in hero.ts: the key sits in the corner of a
             relaxed layout, so whatever cluster the relaxation lands there varies
             by selection, and a halo alone was not enough against it. -->
        <g class="keys" aria-hidden="true">
          {placed.map((m) => (
            <g data-metro-key={m.cbsa} hidden>
              <rect class="keybg" />
              <text class="keytext">
                <tspan class="dot loss" x="0" dy="0">●</tspan><tspan> {m.keyLoss.text}</tspan>
                <tspan class="dot gain" x="0" dy="1.5em">●</tspan><tspan> {m.keyGain.text}</tspan>
              </text>
            </g>
          ))}
        </g>
      </svg>
    </div>

    <!-- The key rides WITH the picture, under it, where a legend belongs. -->
    <p class="keystrip">{HERO_LINES.map((l) => <span>{l.text}</span>)}</p>
  </section>

  <div class="wrap">
    <!-- ── the legend for both marks, one block, small ── -->
    <div class="legend">
      <p class="reg">{REGISTER_FRAME.text}</p>
      <p class="complement">{COMPLEMENT.text}</p>
      {LEGEND.map((l) => <p>{l.text}</p>)}
    </div>

    <!-- ── the claim register: the withheld quarter, on its own scale ── -->
    <section class="claimsec">
      <p class="register">{REGISTER_CLAIM.text}</p>
      <figure class="claimfig" style={`--cut:${(cut * 100).toFixed(3)}%`}>
        <div class="claimwrap">
          <div class="claimplate" set:html={claimSvg} />
          <span class="cap-left">{BAR_DISCLOSED.text}</span>
        </div>
        <figcaption class="claimcap">
          <span class="cap-right">
            <b class="tnum">{BAR_WITHHELD.text}</b>
            {BAR_WITHHELD_SUB.map((s) => <i>{s.text}</i>)}
          </span>
        </figcaption>
      </figure>
      <p class="withheld">{WITHHELD_LINE.text}</p>
      <p class="floor">{FLOOR_NOTE.text}</p>
    </section>

    <!-- ── the three remaining beats, as captions ── -->
    <div class="beats">
      {[BEAT_COUNTY, BEAT_RATES, BEAT_ABSENT].map((b) => (
        <section class="beat">
          <h2>{b[0].text}</h2>
          {b.slice(1).map((p) => <p>{p.text}</p>)}
        </section>
      ))}
    </div>

    <Footer />
  </div>

  <div class="vh" id="live" aria-live="polite"></div>

  <script type="application/json" id="hero-data" set:html={JSON.stringify(heroData)} is:inline></script>
  <script>
    import '../lib/hero.ts';
  </script>
</Layout>
