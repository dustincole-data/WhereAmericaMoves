---
// THE SHAPE, rebuilt after 12's gate. What changed and what did not:
//
// The built page ran ① the claim register → ② no county won → ③ no rates → ④ the absent
// pairs → the explorer, five screens down. It was rejected on three things — too much text
// at too large a size, the map arriving late, and a hero that did not answer the reader —
// and 06's addendum of 2026-08-06 reopened exactly the three rows that produced them: the
// arc's order, the explorer's separation, and prose volume. THE SUBJECT DID NOT REOPEN.
// 03's P2 holds: this is a piece about the record. What changed is that the reader now
// reaches the record by touching the map instead of by reading a paragraph above it.
//
// So the crowd is first, full height, and it is the control. Select a metro and its own
// record is drawn — every direction it sends people, every direction it receives them, and
// the directions the publisher disclosed nothing for, drawn empty. The claim register that
// used to open the page is directly beneath it, which is where the withheld quarter still
// gets its own scale and its own label. C's rule is two labelled registers never summed;
// that is about the labelling, not about which one is on top.
//
// TYPE AND MAP DO NOT OVERLAP, ruled 2026-08-06 after the first shape gate. The round-1 draw
// set the headline inside the plate's own empty regions — measured, and clean at rest — but
// a metro in the north-east throws its heaviest lines straight through that corner, so the
// composition was only honest until the reader used it. The type moves into a rail and the
// crowd takes the whole of what is left.
//
// That costs map area and the trade is stated rather than hidden: a plate at 1240×812 is
// squarer than any laptop viewport, so anything stacked ABOVE it shrinks it twice over —
// once for the height taken and once for the width the aspect then gives back. Beside it,
// the rail costs width only, and the map still fills the screen top to bottom.
//
// The plates still arrive as GEOMETRY ONLY and every sentence on them is below, in the copy
// module. 36px baked text inside a 1240 viewBox scaled to a 390px screen renders at ~11px,
// so a baked headline is unreadable on a phone by construction.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetroReadout from '../components/MetroReadout.astro';
import { METROS } from '../lib/metros';
import { assertPlate, RELATIONS } from '../lib/package';
import { readPlate } from '../lib/plate';
import { metroCopy } from '../copy';
import {
  HOME_TITLE,
  HOME_DESC,
  SITE_NAME,
  HEADLINE,
  STANDFIRST,
  WITHHELD_LINE,
  FLOOR_NOTE,
  REGISTER_CLAIM,
  BAR_DISCLOSED,
  BAR_WITHHELD,
  BAR_WITHHELD_SUB,
  REGISTER_FRAME,
  COMPLEMENT,
  LEGEND,
  HERO_LINES,
  BEAT_COUNTY,
  BEAT_RATES,
  BEAT_ABSENT,
  HERO_ARIA,
  SELECT_LABEL,
  AT_REST,
  RESET,
} from '../copy';

import claimSvgRaw from '../assets/09-claim.svg?raw';
import fieldSvgRaw from '../assets/09-field.svg?raw';
import hues from '../assets/09-hues.json';
import compass from '../assets/09-compass.json';

// The one check hashes do not watch: a plate drawn from an older package, sitting beside a
// fresh manifest. Every emitted plate carries data-package; both are asserted here.
const claimSvg = assertPlate(claimSvgRaw, '09-claim.svg');
const fieldSvg = assertPlate(fieldSvgRaw, '09-field.svg');
const cut = Number(/data-cut="([\d.]+)"/.exec(claimSvg)![1]);

// Hubs and absent pairs are READ OFF THE PLATE rather than re-projected, so the lines cannot
// drift away from the crowd they connect. See lib/plate.ts.
const plate = readPlate(fieldSvg, '09-field.svg');

const site = Astro.site!;
const canonical = new URL('/', site).href;
const ogImage = new URL('/og/index.png', site).href;

const metros = METROS.map((m) => metroCopy(m.cbsa));

// The hero's payload, inlined rather than fetched. It carries NO COPY: every string on this
// page is server-rendered, so the client constructs nothing and the dist scan reads the real
// text rather than a template.
const heroData = {
  viewBox: plate.viewBox,
  hubs: plate.hubs,
  hues: hues.metros,
  pairs: RELATIONS.map((r) => [r.origin, r.dest, r.people]),
  absent: plate.absent,
  // The badges are buttons; buttons need names. The deleted dot map used to set these and the
  // rewrite dropped them, so thirty controls shipped nameless while `metroCopy(...).aria` sat
  // in the ledger unrendered.
  aria: Object.fromEntries(metros.map((m) => [m.cbsa, m.aria.text])),
  // The phone's mark. Geometry only -- bearings and log-distances, apparatus under
  // `contract.apparatus`, never printed. See lib/compass.ts for why the phone cannot use the
  // field: at 390px the plate scales to 0.315 and a metro name renders at 4.7px.
  compass: compass.metros,
  names: Object.fromEntries(metros.map((m) => [m.cbsa, m.name.text])),
};
---

<Layout
  title={HOME_TITLE}
  description={HOME_DESC}
  ogTitle={SITE_NAME}
  ogDesc={HOME_DESC}
  ogImage={ogImage}
  canonical={canonical}
>
  <Header />

  <!-- ── the hero: one thin band, and the crowd taking the rest of the screen ── -->
  <section class="hero">
    <div class="band">
      <h1>{HEADLINE.text}</h1>
      <p class="sf">{STANDFIRST[0].text} <span>{STANDFIRST[1].text}</span></p>

      <!-- One slot, on its own row, holding the invitation at rest and the selected metro's
           record otherwise — with the band's height fixed, so a click never resizes the map
           under the pointer. -->
      <div class="panel">
        <p class="atrest" id="atrest">{AT_REST.text}</p>
        {metros.map((m) => <MetroReadout m={m} />)}
      </div>

      <div class="pick">
        <label class="vh" for="metroPick">{SELECT_LABEL.text}</label>
        <select id="metroPick">
          <option value="">{RESET.text}</option>
          {metros.map((m) => <option value={m.cbsa}>{m.name.text}, {m.state.text}</option>)}
        </select>
      </div>
    </div>

    <div class="stage">
      <div class="field" id="field" set:html={fieldSvg} />
      <!-- The phone's mark. Empty at rest and empty on every desktop width; CSS decides which
           of the two stages is on screen, and `compass.ts` fills this one on selection. -->
      <div class="compass" id="compass" aria-hidden="true" />
      <p class="vh">{HERO_ARIA.text}</p>
    </div>

    <!-- The key rides WITH the picture, under it, where a legend belongs. It used to sit in
         the block below a map that takes the whole viewport, so a line and its explanation
         were never on screen together — the reader met the dashed absences a full scroll
         before being told what they are. -->
    <p class="keystrip">{HERO_LINES.map((l) => <span>{l.text}</span>)}</p>
  </section>

  <div class="wrap">
    <!-- ── the legend for both marks, one block, small ── -->
    <div class="legend">
      <p class="reg">{REGISTER_FRAME.text}</p>
      <p class="complement">{COMPLEMENT.text}</p>
      {LEGEND.map((l) => <p>{l.text}</p>)}
    </div>

    <!-- ── the claim register: the withheld quarter, on its own scale ── -->
    <section class="claimsec">
      <p class="register">{REGISTER_CLAIM.text}</p>
      <figure class="claimfig" style={`--cut:${(cut * 100).toFixed(3)}%`}>
        <div class="claimwrap">
          <div class="claimplate" set:html={claimSvg} />
          <span class="cap-left">{BAR_DISCLOSED.text}</span>
        </div>
        <figcaption class="claimcap">
          <span class="cap-right">
            <b class="tnum">{BAR_WITHHELD.text}</b>
            {BAR_WITHHELD_SUB.map((s) => <i>{s.text}</i>)}
          </span>
        </figcaption>
      </figure>
      <p class="withheld">{WITHHELD_LINE.text}</p>
      <p class="floor">{FLOOR_NOTE.text}</p>
    </section>

    <!-- ── the three remaining beats, as captions ── -->
    <div class="beats">
      {[BEAT_COUNTY, BEAT_RATES, BEAT_ABSENT].map((b) => (
        <section class="beat">
          <h2>{b[0].text}</h2>
          {b.slice(1).map((p) => <p>{p.text}</p>)}
        </section>
      ))}
    </div>

    <Footer />
  </div>

  <div class="vh" id="live" aria-live="polite"></div>

  <script type="application/json" id="hero-data" set:html={JSON.stringify(heroData)} is:inline></script>
  <script>
    import '../lib/hero.ts';
  </script>
</Layout>
