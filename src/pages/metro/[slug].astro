---
// One page per metro, thirty of them, at the URLs v1 published — they are indexed, and 06
// wants them read.
//
// 05's finding is what keeps this page legal: naming is ASSERTION, not election. These
// thirty pages are byte-identical readouts published with nobody clicking, so an
// author-versus-reader rule would be flipped by a build flag — and a rule a build flag can
// flip is not a rule. A readout of a cell's own value names nothing, whoever elected it.
//
// The partner set is the hero's own crowd, filtered to this metro's marks: the same
// geometry, the same cells, one encoding. No rank, no "trades most with", no top-N cut —
// the illegality of a top-N lives in the SET, not in any one label, which is exactly the
// judgment code cannot make.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MetroReadout from '../../components/MetroReadout.astro';
import { METROS } from '../../lib/metros';
import { assertPlate } from '../../lib/package';
import { metroCopy } from '../../copy';
import { say } from '../../copy/record';

import fieldSvgRaw from '../../assets/09-field.svg?raw';

export function getStaticPaths() {
  return METROS.map((m) => ({ params: { slug: m.slug }, props: { cbsa: m.cbsa } }));
}

const { cbsa } = Astro.props as { cbsa: string };
const m = metroCopy(cbsa);
const fieldSvg = assertPlate(fieldSvgRaw, '09-field.svg');

const site = Astro.site!;
const canonical = new URL(`/metro/${m.slug}`, site).href;
const ogImage = new URL(`/og/${m.slug}.png`, site).href;

const back = say('Every metro, and the record they come from', 'apparatus');
---

<Layout
  title={m.title}
  description={m.desc}
  ogTitle={m.ogTitle}
  ogDesc={m.desc}
  ogImage={ogImage}
  canonical={canonical}
>
  <div class="wrap metropage">
    <Header />

    <MetroReadout m={m} heading="h1" />

    <figure class="fieldfig focusfig">
      <div class="field focused" data-focus={m.cbsa} role="img" aria-label={m.partners.text} set:html={fieldSvg} />
      <figcaption class="legend">
        <p>{m.partners.text}</p>
      </figcaption>
    </figure>

    <p class="backlink">
      <a href={`/#${m.cbsa}`}>{back.text}</a>
    </p>

    <Footer />
  </div>

  <script>
    // The one line of client work on this page: light the marks this metro is an end of.
    // The plate ships with data-origin / data-dest on every mark, so the filter is a
    // querySelectorAll over geometry that is already here.
    const f = document.querySelector<HTMLElement>('.field[data-focus]');
    const cbsa = f?.dataset.focus;
    if (f && cbsa) {
      f.querySelectorAll(`[data-dest="${cbsa}"], [data-origin="${cbsa}"], [data-metro="${cbsa}"]`).forEach((n) =>
        n.classList.add('lit')
      );
    }
  </script>
</Layout>
