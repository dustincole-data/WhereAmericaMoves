---
// One page per metro, thirty of them, at the URLs v1 published — they are indexed, and 06
// wants them read.
//
// 05's finding is what keeps this page legal: naming is ASSERTION, not election. These
// thirty pages are byte-identical readouts published with nobody clicking, so an
// author-versus-reader rule would be flipped by a build flag — and a rule a build flag can
// flip is not a rule. A readout of a cell's own value names nothing, whoever elected it.
//
// The figure is the SAME MARK the home page draws, opened on this metro and with the
// controls off. It used to be the old crowd plate filtered to this metro's ribbons; that
// mark no longer exists anywhere, so leaving it here would have shipped thirty pages
// carrying a drawing the rest of the site had replaced and a caption describing neither.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MetroReadout from '../../components/MetroReadout.astro';
import { METROS } from '../../lib/metros';
import { buildField } from '../../lib/field';
import { WIDE } from '../../lib/clusters';
import { metroCopy } from '../../copy';
import { say } from '../../copy/record';
import { SOURCE_TAG } from '../../copy';

import hues from '../../assets/09-hues.json';

export function getStaticPaths() {
  return METROS.map((m) => ({ params: { slug: m.slug }, props: { cbsa: m.cbsa } }));
}

const { cbsa } = Astro.props as { cbsa: string };
const m = metroCopy(cbsa);

// Two views reach this page rather than thirty-one: the one it opens on, and the resting
// country it would return to. Nothing else is worth the bytes on a share page.
const field = buildField();
const placed = field.codes.map((c) => metroCopy(c));
const heroData = {
  codes: field.codes,
  views: { rest: field.views.rest, [cbsa]: field.views[cbsa] },
  wpos: { rest: field.wpos.rest, [cbsa]: field.wpos[cbsa] },
  ppos: field.ppos,
  hues: Object.fromEntries(
    field.codes.map((c) => [c, (hues.metros as Record<string, { hub: string }>)[c]?.hub ?? '#15181d'])
  ),
  focus: cbsa,
};
const sel = field.codes.indexOf(cbsa);

const site = Astro.site!;
const canonical = new URL(`/metro/${m.slug}`, site).href;
const ogImage = new URL(`/og/${m.slug}.png`, site).href;

const back = say('Every metro, and the record they come from', 'apparatus');
---

<Layout
  title={m.title}
  description={m.desc}
  ogTitle={m.ogTitle}
  ogDesc={m.desc}
  ogImage={ogImage}
  canonical={canonical}
>
  <div class="wrap metropage">
    <Header />

    <MetroReadout m={m} heading="h1" />

    <figure class="fieldfig">
      <div class="stage focusstage" id="stage">
        <canvas id="dots" aria-hidden="true"></canvas>
        <svg
          id="over"
          class="over focused"
          viewBox={`0 0 ${WIDE.w} ${WIDE.h}`}
          preserveAspectRatio="xMidYMid meet"
          role="group"
          aria-label={m.partners.text}
        >
          <g class="hits">
            {placed.map((p) => (
              <g data-metro={p.cbsa} aria-hidden="true">
                <circle class="hit" cx="0" cy="0" r="18" fill="transparent" />
              </g>
            ))}
          </g>
          <g class="names">
            {placed.map((p, i) => (
              <text
                data-label={p.cbsa}
                text-anchor="middle"
                transform={`translate(${field.wpos[cbsa][i * 2]},${field.wpos[cbsa][i * 2 + 1] + 26})`}
              >{p.name.text}</text>
            ))}
          </g>
          <text
            id="sourcetag"
            class="srctag"
            text-anchor="middle"
            transform={`translate(${field.wpos[cbsa][sel * 2]},${field.wpos[cbsa][sel * 2 + 1] + 4})`}
          >{SOURCE_TAG.text}</text>
        </svg>
      </div>
      <figcaption class="legend">
        <p>{m.partners.text}</p>
      </figcaption>
    </figure>

    <p class="backlink">
      <a href={`/#${m.cbsa}`}>{back.text}</a>
    </p>

    <Footer />
  </div>

  <script type="application/json" id="hero-data" set:html={JSON.stringify(heroData)} is:inline></script>
  <script>
    import '../../lib/hero.ts';
  </script>
</Layout>
