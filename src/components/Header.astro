---
// Stefaner frame: kicker + framed-finding headline + dek (07 §3). Rendered on the
// explorer and every share route (08 §8.2).
import { META } from '../lib/data';
import { HEADLINE, DEK } from '../lib/copy';
const yr = META.year_pair.replace('-', '–'); // en-dash year tag
---

<header>
  <div class="kicker">Where America Moves · dustincoledata <span class="yr">· {yr} IRS</span></div>
  <h1>{HEADLINE}</h1>
  <div class="dek" set:html={DEK}></div>
</header>
<hr class="rule" />
