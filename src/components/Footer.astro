---
// The limits block, the method note and the package stamp.
//
// 06 puts one of the two our-side findings here rather than in the arc — "nothing here is
// corroborated" is a fact about our checking, and a piece whose spine is three
// publisher-side beats plus one of ours is a negative-list piece rather than a pipeline
// piece. v1's dead per-capita mode is explained here in full, which serves the
// full-explainer preference for brand copy without putting the pipeline in the spine.
//
// The stamp is one appended line. `manifest.json` says a correction is a new package, not
// an edit to an old one — which means nothing unless the package identity is on the page.
// It is honest rather than theatre only because the package is committed into a public
// repository, where b7a3bba21950 resolves to a manifest carrying every claim, every
// limitation and every rejected finding.
import { LIMITS_TITLE, LIMITS, METHOD, METHOD_LINK, STAMP } from '../copy';
---

<footer class="limits" role="contentinfo">
  <!-- ONE control, and `<details>` on purpose rather than a scripted disclosure: it opens with
       no JavaScript, Ctrl-F on a closed block scrolls it open in every current browser, and a
       screen reader reads it as a named expandable region. Nothing here is hidden from the
       dist scan either — every string is server-rendered inside, which is why `lint:copy`
       still reads all of it and why collapsing costs the piece no disclosure. -->
  <details class="limitbox">
    <summary>
      <h2>{LIMITS_TITLE.text}</h2>
    </summary>

    <div class="limitbody">
      {
        LIMITS.map((section) => (
          <section class="limit">
            <h3>{section.head.text}</h3>
            {section.body.map((p) => (
              <p>{p.text}</p>
            ))}
          </section>
        ))
      }

      <section class="method">
        <h3 class="vh">Method</h3>
        {METHOD.map((p) => <p>{p.text}</p>)}
        <p>
          <a href="https://www.irs.gov/statistics/soi-tax-stats-migration-data">{METHOD_LINK.text}</a>
        </p>
      </section>
    </div>
  </details>

  <!-- The stamp stays OUTSIDE the control. It is one line, it is the page's signature, and a
       package identity a reader has to open something to see is not on the page. -->
  <p class="stamp">{STAMP.text}</p>
</footer>
